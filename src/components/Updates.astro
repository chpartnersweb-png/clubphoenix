---
import { Image } from 'astro:assets';
import detail from '../assets/IMG_3532.JPG';
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="updates section-space" id="updates" aria-labelledby="updates-title">
  <div class="shell">
    <div class="section-label" data-reveal><span>04</span><span>STAY CONNECTED</span><span class="label-line"></span></div>
    <div class="updates-layout">
      <div class="updates-visual" data-reveal><h2 id="updates-title">The latest<br /><em>from Phoenix.</em></h2><figure><Image src={detail} alt="CLUB PHOENIXの店内にある光るフェニックスの壁面ロゴ" width={440} format="webp" quality={85} sizes="(max-width: 760px) 44vw, 24vw" loading="lazy" /></figure></div>
      <div class="social-list" data-reveal>
        <p class="social-intro">お店のいまを、こちらから。</p>
        <a class="social-link" href={site.instagram} target="_blank" rel="noopener noreferrer"><div><span class="social-eyebrow">NEWS & MOMENTS</span><span class="social-title">Instagram</span><span class="social-description">お店の最新情報を見る</span></div><Icon name="external" /><span class="sr-only">（新しいタブで開きます）</span></a>
        <a class="social-link" href={site.pokepara} target="_blank" rel="noopener noreferrer"><div><span class="social-eyebrow">CAST & BLOG</span><span class="social-title social-title--pokepara">POKEPARA</span><span class="social-description">キャスト情報・ブログを見る</span></div><Icon name="external" /><span class="sr-only">（新しいタブで開きます）</span></a>
      </div>
    </div>
  </div>
</section>
