---
interface Props {
  name: 'arrow' | 'external' | 'phone' | 'pin' | 'instagram';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15M13 5l7 7-7 7" />}
  {name === 'external' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'phone' && <path d="m7.2 3.5 3 4.8-2.1 2.1a15 15 0 0 0 5.5 5.5l2.1-2.1 4.8 3c.3.2.4.6.3.9l-.6 2.2c-.2.6-.8 1-1.4 1C10.5 20.4 3.6 13.5 3.1 5.2c0-.6.4-1.2 1-1.4l2.2-.6c.3-.1.7 0 .9.3Z" />}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
</svg>
