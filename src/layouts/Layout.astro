---
import { getImage } from 'astro:assets';
import storePhoto from '../assets/IMG_3528.JPG';
import { site } from '../data/site';
import '../styles/global.css';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const og = await getImage({ src: storePhoto, width: 783, format: 'jpg', quality: 90 });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0d12" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <><meta property="og:image" content={ogUrl} /><meta property="og:image:alt" content="CLUB PHOENIXの店内" /></>}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
