---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Atmosphere from '../components/Atmosphere.astro';
import Drinks from '../components/Drinks.astro';
import System from '../components/System.astro';
import Updates from '../components/Updates.astro';
import AccessContact from '../components/AccessContact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
---
<Layout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <Atmosphere />
    <Drinks />
    <System />
    <Updates />
    <AccessContact />
  </main>
  <SiteFooter />
  <MobileContactBar />
</Layout>
